    </inertial>
  </link>
    

  <link name="wheel1">
    <visual>
      <geometry>
        <mesh filename="file://home/abhiyaan-orin/isaac_ros-dev/src/isaac_ros_common/src/vsim/meshes/igvc/igvc_wheel.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy ="0 0 0" xyz="0 0 0"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.12" length="0.04"/>
      </geometry>
      <origin rpy ="1.5707 0 1.5707" xyz="-0.065 0 0"/>
    </collision>

    <inertial>
      <mass value="5"/>
      <inertia ixx="0.166667" ixy="0.0" ixz="0.0" iyy="0.166667" iyz="0.0" izz="0.166667"/>
    </inertial>
  </link>

  <link name="wheel2">
    <visual>
      <geometry>
        <mesh filename="file://home/abhiyaan-orin/isaac_ros-dev/src/isaac_ros_common/src/vsim/meshes/igvc/igvc_wheel.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    <origin rpy ="0 0 0" xyz="0 0 0"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.12" length="0.04"/>
      </geometry>
      <origin rpy ="1.5707 0 1.5707" xyz="-0.065 0 0"/>
    </collision>

    <inertial>
      <mass value="5"/>
      <inertia ixx="0.166667" ixy="0.0" ixz="0.0" iyy="0.166667" iyz="0.0" izz="0.166667"/>
    </inertial>
  </link>

  <link name="castor_ball">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>

    <inertial>
      <mass value="3"/>
      <inertia ixx="0.166667" ixy="0.0" ixz="0.0" iyy="0.166667" iyz="0.0" izz="0.166667"/>
    </inertial>
  </link>

  <link name="castor_cylinder">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
      <origin rpy ="0 0 0" xyz="0 0 0"/>
    </collision>
      
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.166667" ixy="0.0" ixz="0.0" iyy="0.166667" iyz="0.0" izz="0.166667"/>
    </inertial>
  </link>

  <link name="castor_ball2">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
