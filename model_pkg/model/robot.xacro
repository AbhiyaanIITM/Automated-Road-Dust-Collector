<?xml version="1.0"?>
<robot name="vnymous">
	
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin rpy="0 -0 1.5707" xyz="0 0.35 0"/>
      <geometry>
        <mesh filename="file://home/abhiyaan-orin/isaac_ros-dev/src/isaac_ros_common/src/vsim/meshes/igvc/igvc_bot.dae" scale="0.001 0.001 0.001"/>
